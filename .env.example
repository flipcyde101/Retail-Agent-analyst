# Copy to .env and fill in. .env is gitignored: never commit it.

# PostgreSQL (local Docker)
POSTGRES_USER=retail_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retail
POSTGRES_PORT=5432
# POSTGRES_HOST=127.0.0.1   # only needed when the database is not local

# Read-only role the agent connects with (created by data/load.py)
AGENT_DB_USER=agent_ro
AGENT_DB_PASSWORD=change-me-too

# A hosted database instead of the local one (see "Deploy" in the README). Each is a whole
# connection string and wins over the separate values above when it is set.
#   ADMIN_DATABASE_URL  the owner's connection string; only data/load.py uses it
#   AGENT_DATABASE_URL  the read-only role's connection string; what the agent uses
# ADMIN_DATABASE_URL=postgresql://owner:password@host/dbname?sslmode=require
# AGENT_DATABASE_URL=postgresql://agent_ro:password@host/dbname?sslmode=require

# Model for the agent, in PydanticAI's provider:model format, plus that provider's API key
# under its standard name (ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY...).
# Anthropic is already installed by uv sync. Another provider needs its extra, e.g.:
#   uv add "pydantic-ai-slim[openai]"
LLM_MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=
